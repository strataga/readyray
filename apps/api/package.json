{
  "name": "@archgauge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "bun run build && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.test.ts\"",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/persistence/postgres/migrate.ts"
  },
  "dependencies": {
    "@archgauge/evidence": "workspace:*",
    "@archgauge/reviews": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
